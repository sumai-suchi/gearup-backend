model RentalOrder {
  id            String        @id @default(cuid())


  customerId    String
  gearId        String


  startDate     DateTime
  endDate       DateTime


  totalDays     Int
  totalAmount   Float


  status        RentalStatus  @default(PLACED)


  customer      User      @relation("CustomerRentals", fields: [customerId], references: [id], onDelete: Cascade)
  gear          GearItem  @relation(fields: [gearId], references: [id])


  payment       Payment?


  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
