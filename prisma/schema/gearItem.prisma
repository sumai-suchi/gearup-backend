model GearItem {
  id            String   @id @default(cuid())


  title         String
  description   String
  brand         String
  image         String


  pricePerDay   Float
  stock         Int


  isAvailable   Boolean  @default(true)


  providerId    String
  categoryId    String


  provider      User      @relation("ProviderGear", fields: [providerId], references: [id], onDelete: Cascade)
  category      Category  @relation(fields: [categoryId], references: [id])


  rentals       RentalOrder[]
  reviews       Review[]


  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
